# Copy this file to `.env` and fill in your tokens.
# `.env` is git-ignored. NEVER commit real tokens.

# Hugging Face Inference API token (free tier). Get one at:
#   https://huggingface.co/settings/tokens
# Token format starts with `hf_`. Read-only scope is sufficient.
HF_TOKEN=

# Optional: HF user agent string for polite identification on the API.
HF_USER_AGENT=apd-audit/0.1 (academic; contact: example@example.org)
