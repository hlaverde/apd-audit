# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Virtual environment
.venv/
venv/
env/

# uv
.uv/
# uv.lock IS committed — it pins exact dependency versions for full
# replicability per the editorial claim. Remove this comment block if you
# decide to switch to unlocked installs.

# Notebooks
.ipynb_checkpoints/

# Secrets
.env
.env.local
*.token
hf_token*

# Run-time logs (Tee-Object captures)
generate_log.txt
*.log

# Data — raw downloads and intermediate artifacts are NEVER committed
data/raw/
data/interim/
data/processed/*.parquet

# Generated images — never committed (only metadata is, when small enough)
images/poc/*/
images/main/*/
*.png
!tests/fixtures/sample_images/*.png

# Results — figures regenerable, do not commit unless reviewed
results/figures/*.png
results/figures/*.pdf
results/tables/*.csv

# Large parquets (>50MB) - excluded by convention
# Use `git lfs` or document in DECISIONS.md if needed

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Allow production metadata files (the parquets � not the PNGs)
!images/main/metadata.parquet
!images/main/metadata_*.parquet

